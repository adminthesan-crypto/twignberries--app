{
  "manifest_version": 3,
  "name": "Pahruli: Offline Arsenal",
  "version": "1.0.0",
  "description": "100+ offline utility tools for founders and builders. Compress PDFs, calculate Stripe fees, crop images, and more—100% offline.",
  "action": {
    "default_title": "Open Pahruli Offline Arsenal"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "icons": {
    "16": "vite.svg",
    "32": "vite.svg",
    "48": "vite.svg",
    "128": "vite.svg"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
